<Window x:Class="Sc2Timer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC2 Build Timer" Height="560" Width="380"
        Background="#FF12161C" WindowStartupLocation="CenterScreen"
        Topmost="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FF1E2530" />
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderBrush" Value="#FF3A4552" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="SC2 BUILD TIMER" Foreground="#FF7FD1AE" FontSize="14"
                   FontWeight="Bold" HorizontalAlignment="Center" />

        <TextBlock Grid.Row="1" x:Name="BuildNameText" Text="No build order loaded"
                   Foreground="#FF8A94A6" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />

        <TextBlock Grid.Row="2" x:Name="ClockText" Text="00:00" Foreground="White"
                   FontFamily="Consolas" FontSize="56" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,14,0,10" />

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,0,0,18">
            <TextBlock Text="NEXT" Foreground="#FF8A94A6" FontSize="12" HorizontalAlignment="Center" />
            <TextBlock x:Name="NextLabel" Text="—" Foreground="#FFFFD479" FontSize="22"
                       FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" />
            <TextBlock x:Name="NextCountdown" Text="" Foreground="#FF8A94A6" FontSize="13"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="4">
            <TextBlock Text="UPCOMING" Foreground="#FF8A94A6" FontSize="12" Margin="0,0,0,4" />
            <ListBox x:Name="UpcomingList" Background="Transparent" BorderThickness="0"
                     Foreground="#FFCBD3DD" FontFamily="Consolas" FontSize="14" />
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
            <Button x:Name="ImportButton" Content="IMPORT" Click="OnImportClick" />
            <Button x:Name="StartButton" Content="START" Click="OnStartClick" />
            <Button x:Name="PauseButton" Content="PAUSE" Click="OnPauseClick" />
            <Button x:Name="ResetButton" Content="RESET" Click="OnResetClick" />
        </StackPanel>
    </Grid>
</Window>
